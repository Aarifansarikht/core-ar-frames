{
  "name": "bay81-web-core-ar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "WebAR poster experiences tracked by the 8th Wall engine, on a Three.js renderer.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "dev:https": "vite --host --mode https",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/prepare-assets.mjs",
    "test:registration": "node scripts/check-registration.mjs",
    "test:ui": "node scripts/test-ui.mjs",
    "test:device": "node scripts/test-device.mjs",
    "targets": "node scripts/compile-targets.mjs"
  },
  "dependencies": {
    "@8thwall/engine-binary": "1.0.0",
    "@fontsource-variable/inter": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "meshoptimizer": "^1.3.0",
    "playwright-core": "^1.64.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
